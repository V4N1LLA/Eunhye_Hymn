#!/bin/sh

# Gradle start up script for POSIX generated by Gradle.

APP_HOME=$(cd "${0%/*}" && pwd)

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

MAX_FD="maximum"

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

OS=$(uname)
case "$OS" in
  CYGWIN*|MINGW*|MSYS*)
    CYGWIN=true
    ;;
  Darwin*)
    DARWIN=true
    ;;
  *)
    ;;
 esac

if [ -z "$JAVA_HOME" ] ; then
  JAVA_EXEC=$(command -v java) || die "JAVA_HOME is not set and java could not be found in PATH."
else
  JAVA_EXEC="$JAVA_HOME/bin/java"
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
  die "Missing gradle-wrapper.jar"
fi

exec "$JAVA_EXEC" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
