# Eunhye Hymn - 환경변수 예시
# Docker Compose (infra/docker/) 기준 기본값이 설정되어 있습니다.
# 이 파일을 .env 로 복사한 뒤 필요한 값을 수정하세요.
#   cp .env.example .env

# ── Database (PostgreSQL) ──────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/eunhye_hymn
DB_USER=postgres
DB_PASS=postgres

# ── 인증 (JWT / 초대코드) ─────────────────────────────────────
JWT_SECRET=replace-with-random-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
INVITE_CODE=replace-with-invite-code

# ── S3 Storage (LocalStack) ───────────────────────────────────
S3_BUCKET=local-bucket
S3_REGION=ap-northeast-2
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_BASE_URL=http://localhost:4566/local-bucket
S3_PRESIGN_EXPIRES_MINUTES=15
