# ==============================================================
# Eunhye Hymn local development environment template
# ==============================================================
# Usage:
#   cp .env.example .env
#
# This file is for local development defaults only.
# Never commit real secrets to Git.
# ==============================================================

# PostgreSQL
POSTGRES_DB=eunhye_hymn
DB_USER=postgres
DB_PASS=postgres

# JWT (required)
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars!!
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Invite code (required)
INVITE_CODE=dev-invite-code

# Admin allowlist (optional)
# - If ADMIN_ENFORCE_ADMIN_ONLY=true, only allowlisted operators can log in via social login.
ADMIN_EMAILS=
ADMIN_KAKAO_SUBJECTS=
ADMIN_ENFORCE_ADMIN_ONLY=false

# Admin ID/PW login (optional)
ADMIN_LOGIN_ID=
ADMIN_LOGIN_PASSWORD=

# S3 / LocalStack
S3_BUCKET=local-bucket
S3_REGION=ap-northeast-2
S3_ENDPOINT=http://localstack:4566
S3_PUBLIC_BASE_URL=http://localhost:4566/local-bucket
S3_PRESIGN_EXPIRES_MINUTES=15

# Spring profile
SPRING_PROFILES_ACTIVE=dev
