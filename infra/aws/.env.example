# Production environment variables for docker-compose.prod.yml
# Copy to .env and fill in values from Terraform outputs.
# Never commit real values.

# ECR / AWS
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
AWS_REGION=ap-northeast-2

# Database (from Terraform output: rds_endpoint)
DB_URL=jdbc:postgresql://eunhye-hymn-db.xxxx.ap-northeast-2.rds.amazonaws.com:5432/eunhye_hymn
DB_USER=postgres
DB_PASS=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Auth
INVITE_CODE=CHANGE_ME
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
ADMIN_KAKAO_SUBJECTS=
ADMIN_ENFORCE_ADMIN_ONLY=false
ADMIN_LOGIN_ID=
ADMIN_LOGIN_PASSWORD=

# S3 (from Terraform output)
S3_BUCKET=eunhye-hymn-assets-staging
S3_REGION=ap-northeast-2
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=https://eunhye-hymn-assets-staging.s3.ap-northeast-2.amazonaws.com
S3_PRESIGN_EXPIRES_MINUTES=15

# Spring
SPRING_PROFILES_ACTIVE=prod
